# POST demo environment. Names only — never put secrets in EXPO_PUBLIC_ variables.
# Model, messaging, database, signing, token-pepper, and notification credentials
# belong on a trusted backend, never in the app bundle.
EXPO_PUBLIC_APP_ENV=demo
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_ENABLE_CARE_AGENT=false
EXPO_PUBLIC_ENABLE_DEMO_AGENT_RUNS=true
EXPO_PUBLIC_ENABLE_CARE_PASSPORT=true
EXPO_PUBLIC_ENABLE_DEMO_ROLE_SWITCH=true
# Public HTTPS page for the optional, non-clinical AI assistant link. The app
# hides the link when this is empty. Never place an AI provider key here.
EXPO_PUBLIC_AGENT_FREE_AI_URL=

# Trusted backend only (do not prefix these with EXPO_PUBLIC_ and do not put a
# live value in this file):
SWALA_SMS_BASE_URL=https://swalasms.com/api/v1
SWALA_SMS_API_KEY=
SWALA_SMS_SENDER_ID=
