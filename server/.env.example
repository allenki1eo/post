# Postgres
DATABASE_URL=postgres://postgres@127.0.0.1:5432/post

# HTTP
PORT=3000
SESSION_SECRET=change-me-in-production

# Africa's Talking. Leave SMS_GATEWAY=fake in dev — the fake gateway records
# messages to the outbox so the whole loop is testable without spending credit.
SMS_GATEWAY=fake
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=POST
AT_BASE_URL=https://api.sandbox.africastalking.com

# Reminder engine
WORKER_TICK_MS=15000
QUIET_HOURS_START=21
QUIET_HOURS_END=6
DOSE_GRACE_HOURS=3
MAX_SEND_ATTEMPTS=3
